class Solution {
    public int rob(int[] nums) {
        if (nums.length == 1) return nums[0];
        return Math.max(rob(nums, 0, nums.length - 2),
                        rob(nums, 1, nums.length - 1));
    }

    int rob(int[] a, int l, int r) {
        int prev = 0, curr = 0;
        for (int i = l; i <= r; i++) {
            int temp = curr;
            curr = Math.max(curr, prev + a[i]);
            prev = temp;
        }
        return curr;
    }
}
